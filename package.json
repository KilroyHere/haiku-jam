{
  "name": "morrow-poetry",
  "version": "0.1.0",
  "description": "Morrow is a collaborative three-line poetry PWA.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:e2e": "firebase emulators:exec --project morrow-rules-test --only auth,firestore \"playwright test\"",
    "test:e2e:browser": "playwright test",
    "lighthouse": "lighthouse http://127.0.0.1:3000 --only-categories=accessibility,best-practices --output=json --output-path=lighthouse-report.json --chrome-flags='--headless --no-sandbox'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KilroyHere/haiku-jam.git"
  },
  "keywords": [
    "poetry",
    "pwa",
    "firebase",
    "nextjs"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KilroyHere/haiku-jam/issues"
  },
  "homepage": "https://github.com/KilroyHere/haiku-jam#readme",
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
