# Public Firebase web app configuration. These identifiers are safe for browser use;
# Firestore Security Rules are the authorization boundary.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Canonical production URL, used for metadata and public share links.
NEXT_PUBLIC_SITE_URL=

# Local development only.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
